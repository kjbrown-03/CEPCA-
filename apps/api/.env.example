# OBLIGATOIRE
DATABASE_URL=postgresql://cepca:cepca_dev@127.0.0.1:5434/cepca
# OBLIGATOIRE en production : 32 caractères minimum, différents l'un de l'autre
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
OTP_PEPPER=change-me-dev-otp-pepper-at-least-32-chars
# Valeurs par défaut acceptables en dev
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# false en dev (IP de la socket), loopback en production derrière nginx
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:4000
# Stockage objet (MinIO en dev)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=cepca-media
S3_ACCESS_KEY=cepca
S3_SECRET_KEY=cepca_dev_minio
# Paiement : SANDBOX en dev ; MTN_MOMO / ORANGE_MONEY réels en production
PAYMENT_MODE=SANDBOX
SANDBOX_CONFIRM_DELAY_MS=2500
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# SMS : console en dev (le code s'affiche dans le terminal de l'API)
SMS_MODE=console
