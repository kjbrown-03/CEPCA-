# OBLIGATOIRE
DATABASE_URL=postgresql://cepca:cepca_dev@127.0.0.1:5434/cepca
# OBLIGATOIRE en production : 32 caractères minimum, différents l'un de l'autre
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
OTP_PEPPER=change-me-dev-otp-pepper-at-least-32-chars
# Valeurs par défaut acceptables en dev
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# false en dev (IP de la socket), loopback en production derrière nginx
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:4000
# Stockage objet (MinIO en dev)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=cepca-media
S3_ACCESS_KEY=cepca
S3_SECRET_KEY=cepca_dev_minio
# Paiement : simulator (local, hors ligne) ou fapshi (MTN MoMo + Orange Money)
PAYMENT_PROVIDER=simulator
SANDBOX_CONFIRM_DELAY_MS=2500
# Fapshi : https://sandbox.fapshi.com en test, https://live.fapshi.com en production
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Même valeur que le « webhook secret » du tableau de bord Fapshi (en-tête x-wh-secret)
FAPSHI_WEBHOOK_SECRET=
# E-mails (codes de connexion, nominations, notifications) — aucun SMS.
# console : l'e-mail s'affiche dans le terminal de l'API (dev) ; smtp : envoi réel par nodemailer.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adresse Gmail, SMTP_PASS=mot de passe d'application (16 lettres).
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CEPCA <no-reply@cepca.org>
# Notifications push de l'application web (PWA). Générer une paire : npx web-push generate-vapid-keys
# Vides : envoi simulé dans le terminal. La clé privée ne quitte jamais le serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@cepca.org
