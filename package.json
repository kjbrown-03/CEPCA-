{
  "name": "cepca-digital",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mail:test": "npm run mail:test -w @cepca/api --",
    "setup": "npm run build -w @cepca/tokens -w @cepca/shared && npm run prisma:generate -w @cepca/api && npm run prisma:deploy -w @cepca/api",
    "dev": "npm run dev:api",
    "seed": "npm run db:seed",
    "dev:db": "docker compose -f deploy/compose.dev.yml up -d",
    "dev:api": "npm run start:dev -w @cepca/api",
    "dev:web": "npm run dev -w @cepca/web",
    "dev:mobile": "npm run start -w @cepca/mobile",
    "db:migrate": "npm run prisma:migrate -w @cepca/api",
    "db:seed": "npm run seed -w @cepca/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
